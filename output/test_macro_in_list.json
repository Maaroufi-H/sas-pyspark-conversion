    "testo": "%macro filtra_prodotti(nid, id_prodotto1, id_prodotto2, id_prodotto3);\n\nproc sql;\n    create table work.risultato as\n    select *\n    from source.vendite\n    where prodotto_cod in (\n        %if &nid = 1 %then %do;\n            \"&id_prodotto1.\"\n        %end;\n        %else %do;\n            %do i=1 %to &nid;\n                %if &i ^= &nid %then %do;\n                    \"&&id_prodotto&i\",\n                %end;\n                %else %do;\n                    \"&&id_prodotto&i\"\n                %end;\n            %end;\n        %end;\n    )\n    and data_vendita >= '2024-01-01';\nquit;\n\n%mend filtra_prodotti;\n",
